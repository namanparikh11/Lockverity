# =====================================================================
# Lockverity v0.1 - .gitignore
# =====================================================================
# Defensive security product. We never commit secrets, fixtures that
# could be confused for real data, or environment-specific state.

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
svar/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
.cache
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers
.mypy_cache/
.ruff_cache/

# Alembic local artefacts (we keep the script directory under VCS)
backend/alembic/versions/__pycache__/

# --- Node / Frontend ---
node_modules/
.pnp
.pnp.js
.npm/
.eslintcache
.vite/
dist/
dist-ssr/
*.local
.parcel-cache
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/

# OS junk
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.fleet/
.cursor/

# Local environment files
.env
.env.local
.env.*.local
.env.development
.env.production

# Lockverity runtime artefacts
# Workspace and runtime uploads - never commit user-provided archives
/var/
backend/var/
backend/runtime/
backend/run/
backend/.lockverity/
*.lockverity.sqlite
*.lockverity.sqlite-journal
*.lockverity.sqlite-wal
*.lockverity.sqlite-shm
workspaces/
uploads/
tmp/
tmp.*

# Frontend runtime / dev-only artefacts (vite proxy log,
# convenience start scripts, etc.). The frontend has no
# committed runtime state; the v0.4 integrated smoke runs
# Vite through the standard ``npm run dev`` entry point.
frontend/var/

# Generated coverage / build reports
backend/coverage/
frontend/coverage/
backend/htmlcov/

# CI-generated noise
.ci-cache/

# v2.1 Part B3A Windows portable packaging artefacts
# The dedicated packaging work directory and the
# generated portable bundle must never be committed.
# The ``build/`` and ``dist/`` entries higher up cover
# the broad case; the explicit entries below document
# the B3A layout and ensure the generated portable
# root, the SHA-256 / manifest / notices outputs, and
# the final ZIP remain untracked even if a future
# maintainer narrows the broad entries.
build/packaging/
backend/build/packaging/
backend/dist/windows/
# Generated portable root, the final ZIP, and the
# build manifest / SHA-256 / notices outputs are
# only ever produced by ``scripts/build_windows_portable.py``
# and live under the packaging output directory.
**/build/packaging/**/*.windows-x64-portable/
**/build/packaging/*.windows-x64-portable.zip
**/build/packaging/**/THIRD_PARTY_NOTICES.txt
**/build/packaging/**/BUILD-MANIFEST.json
**/build/packaging/**/SHA256SUMS.txt
**/build/packaging/**/Lockverity.exe
**/build/packaging/**/lockverity-cli.exe
# PyInstaller per-spec scratch (the build script
# always passes an explicit ``workpath`` so this is
# normally empty; the entry documents the
# contract).
**/build/packaging/**/_internal/
# The packaging-derivative ICO is regenerated by
# ``scripts/generate_exe_icon.py`` at every build
# from the approved symbol PNG
# (``frontend/public/brand/lockverity-symbol.png``).
# Committing it would duplicate the approved source;
# the build script is the documented chokepoint.
backend/pyinstaller/favicon-exe.ico
# The transparent 1024px Windows master PNG is a
# mechanical derivative of the same approved symbol
# regenerated by the same script. It follows the
# same policy as the ICO: generated at build time,
# never committed.
backend/pyinstaller/favicon-exe-master.png
# The build script's per-spec PyInstaller logs are
# written under ``build/packaging/logs/`` so the
# operator can inspect a failed build without
# re-running the pipeline. The logs are build
# artefacts and must not be committed.
build/packaging/logs/
**/build/packaging/logs/
# The build script's redirected stdout / stderr /
# exit-code capture files in ``backend/`` are
# transient invocation output and must not be
# committed. The patterns cover both the legacy
# single-file redirect (e.g. ``backend/build-stdout.txt``)
# and the build-step-numbered capture files emitted
# by multi-iteration acceptance runs.
backend/build-stdout.txt
backend/build-stderr.txt
backend/build-exit.txt
backend/test-build.txt
backend/build-b3b-summary.txt
backend/build-b3b-stdout.log
backend/build-b3b-stderr.log
backend/build-installer*.stdout.log
backend/build-installer*.stderr.log
backend/build-installer*-stdout.log
backend/build-installer*-stderr.log


# Local databases and temporary artifacts
*.sqlite
*.sqlite3
*.sqlite*
*.db
*.bak
__pycache__/
.pytest_cache/
# TypeScript incremental build artifacts
*.tsbuildinfo

